# ==============================================================================
# PromptOps Environment Configuration
# ==============================================================================

# Server Configuration
PROMPTOPS_HOST=127.0.0.1
PROMPTOPS_PORT=8000
PROMPTOPS_ENV=production

# Model Provider API Keys (Optional - Deterministic Mock adapter works offline with 0 keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Circuit Breaker & Execution Timeouts
DEFAULT_TIMEOUT_SECONDS=15.0
CIRCUIT_BREAKER_TIMEOUT_SECONDS=3.0
ENABLE_LLM_REFLECTION=true
